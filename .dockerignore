# Keep the build context small and keep secrets out of the image.
#
# .env is the load-bearing line here: it holds API keys, and a file copied into a
# layer stays in that layer even if a later instruction deletes it. Keys are passed
# at run time with --env-file or -e instead.

.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

.git/
.gitignore
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Fetched IRAS HTML: gitignored, never redistributed, and not needed at runtime.
.scratch/

# Build-time notes and the assessment brief -- not part of the running system.
ref material/
AI assistant logs/
docs/

# Demo recordings are linked from the README and are not needed by Streamlit.
# Keeping them out of the build context avoids transferring large media files on
# every Docker build without removing them from the repository.
*.mp4
*.mov
*.webm

# The training notebook and the eval PNGs are documentation, not runtime inputs.
# models/*.ipynb is excluded; models/classifier and models/all-MiniLM-L6-v2 are NOT
# -- the weights must ship in the image.
models/*.ipynb

Dockerfile
.dockerignore
